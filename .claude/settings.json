{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(uv *)",
      "Bash(pip install *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(ruff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git stash *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git clean *)",
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",

      "mcp__Beehiv__save_post",
      "mcp__Beehiv__edit_post",
      "mcp__Beehiv__edit_post_content",
      "mcp__Beehiv__duplicate_post",
      "mcp__Beehiv__save_post_template",
      "mcp__Beehiv__edit_post_template",
      "mcp__Beehiv__edit_post_template_content",
      "mcp__Beehiv__save_automation",
      "mcp__Beehiv__save_automation_email",
      "mcp__Beehiv__save_automation_trigger",
      "mcp__Beehiv__edit_automation_email_content",
      "mcp__Beehiv__add_automation_step",
      "mcp__Beehiv__update_automation_step",
      "mcp__Beehiv__reorder_automation_steps",
      "mcp__Beehiv__delete_automation_step",
      "mcp__Beehiv__delete_automation_trigger",
      "mcp__Beehiv__edit_page",
      "mcp__Beehiv__save_subscribe_form",
      "mcp__Beehiv__save_signup_flow",
      "mcp__Beehiv__save_site_redirect",
      "mcp__Beehiv__save_recommendation",
      "mcp__Beehiv__save_podcast_episode",
      "mcp__Beehiv__save_podcast_show",
      "mcp__Beehiv__delete_podcast_episode",
      "mcp__Beehiv__delete_podcast_show",
      "mcp__Beehiv__save_product",
      "mcp__Beehiv__duplicate_product",
      "mcp__Beehiv__save_tier",
      "mcp__Beehiv__save_sponsorship_product",
      "mcp__Beehiv__save_poll",
      "mcp__Beehiv__save_survey",
      "mcp__Beehiv__save_survey_question",
      "mcp__Beehiv__save_subscriber_tag",
      "mcp__Beehiv__save_newsletter_list_preference",
      "mcp__Beehiv__add_segment_to_newsletter_list",

      "mcp__Canva__publish-brand-template",
      "mcp__Canva__comment-on-design",
      "mcp__Canva__reply-to-comment",
      "mcp__Canva__request-outline-review",

      "mcp__Vercel__deploy_to_vercel",
      "mcp__Vercel__buy_domain",
      "mcp__Vercel__buy_pro",
      "mcp__Vercel__buy_credits",
      "mcp__Vercel__buy_addon",
      "mcp__Vercel__get_purchase_quote",
      "mcp__Vercel__reply_to_toolbar_thread",
      "mcp__Vercel__add_toolbar_reaction",
      "mcp__Vercel__edit_toolbar_message",
      "mcp__Vercel__change_toolbar_thread_resolve_status",

      "mcp__Supabase__create_project",
      "mcp__Supabase__pause_project",
      "mcp__Supabase__restore_project",
      "mcp__Supabase__deploy_edge_function",
      "mcp__Supabase__apply_migration",
      "mcp__Supabase__execute_sql",
      "mcp__Supabase__confirm_cost",
      "mcp__Supabase__merge_branch",
      "mcp__Supabase__delete_branch",
      "mcp__Supabase__reset_branch",
      "mcp__Supabase__rebase_branch",

      "mcp__Spotify__create_playlist",

      "mcp__Adobe_for_creativity__asset_invite_collaborators",
      "mcp__Adobe_for_creativity__asset_share_link",
      "mcp__Adobe_for_creativity__asset_license_and_download_stock",

      "mcp__Supermetrics_Marketing_Analytics__campaign_create",
      "mcp__Supermetrics_Marketing_Analytics__campaign_update",
      "mcp__Supermetrics_Marketing_Analytics__manage_user_and_team",

      "mcp__Google_Drive__create_file",
      "mcp__Google_Drive__copy_file",

      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "mcp__github__delete_file",
      "mcp__github__create_or_update_file",
      "mcp__github__push_files",
      "mcp__github__create_repository",
      "mcp__github__fork_repository",
      "mcp__github__actions_run_trigger"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production*)",
      "Read(./**/.env.development*)",
      "Read(./**/secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa*)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Edit(./**/.env.production*)",
      "Edit(./**/secrets/**)"
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 300,
            "statusMessage": "Installing project dependencies"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/git-push-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-and-lint.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/test-gate.sh",
            "timeout": 600,
            "statusMessage": "Running test gate"
          }
        ]
      }
    ]
  }
}
